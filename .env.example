# Copy to .env and fill in values from Supabase → Project Settings → API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Zalo OA — Gửi ZNS hàng loạt (App ID là thông tin công khai, dùng để dựng URL cấp quyền OAuth).
# Lấy tại developers.zalo.me → ứng dụng của bạn → Thông tin ứng dụng.
VITE_ZALO_APP_ID=your-zalo-app-id
# Phải khớp CHÍNH XÁC với Redirect URI đã đăng ký trong Zalo App console.
VITE_ZALO_OAUTH_REDIRECT_URI=http://localhost:5173/zalo/oauth-callback

# LƯU Ý: App Secret của Zalo KHÔNG được đặt ở đây (không VITE_ prefix = sẽ lộ ra trình duyệt).
# App Secret phải được set làm Supabase Edge Function secret, xem README/hướng dẫn triển khai:
#   npx supabase secrets set ZALO_APP_SECRET=your-zalo-app-secret
