{
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ],
  "rewrites": [
    {
      "source": "/api/:function*",
      "destination": "https://crcqyaphmaxgkrhffevl.supabase.co/functions/v1/:function*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
